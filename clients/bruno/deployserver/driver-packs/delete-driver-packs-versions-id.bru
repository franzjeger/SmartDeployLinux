meta {
  name: Delete a driver-pack version
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/driver-packs/versions/:id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: uuid
}

headers {
  Accept: application/json
}

docs {
  Requires `image.write`.
}
