meta {
  name: Register a built bootstrap stick
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/bootstrap-sticks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "ca_fingerprint": "<string>",
    "deploy_url": "<string>",
    "image_sha256": "<string>",
    "label": "<string>",
    "tailnet": "<string>"
  }
}

docs {
  Requires `stick.write` or `*`.
}
