meta {
  name: Cancel a non-terminal job
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/jobs/:id/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: uuid
}

headers {
  Accept: application/json
}

docs {
  Requires `deployment.create`. Revokes the job's boot tokens.
}
