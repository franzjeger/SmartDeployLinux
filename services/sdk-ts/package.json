{
  "name": "@your-org/deployserver-sdk",
  "version": "1.0.0",
  "description": "Typed TypeScript/JavaScript client for the deployserver operator API.",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "files": [
    "dist/src",
    "openapi.yaml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "sync-spec": "cp ../api/internal/apispec/openapi.yaml ./openapi.yaml"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "yaml": "^2.6.1"
  }
}
