# Public FQDN of the deploy server. Sticks bake this in. Cert presented on
# this name MUST chain to the CA whose cert is embedded on the stick.
DEPLOY_FQDN=deploy.example.com

# Tailnet config. Sticks bake the tailnet name in.
# For Headscale:
HEADSCALE_URL=https://headscale.example.com
HEADSCALE_API_KEY=
HEADSCALE_USER=deploy
# Or, for Tailscale SaaS, leave HEADSCALE_* empty and set:
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=

# Postgres.
POSTGRES_USER=deploy
POSTGRES_PASSWORD=changeme-please
POSTGRES_DB=deploy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MinIO / S3.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=deploy
S3_SECRET_KEY=changeme-please-too
S3_BUCKET_IMAGES=images
S3_BUCKET_DRIVERS=drivers
S3_BUCKET_BLOBS=blobs

# OIDC (for human users / operator UI).
OIDC_ISSUER=https://auth.example.com/realms/deploy
OIDC_CLIENT_ID=deployserver
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://deploy.example.com/auth/callback

# Internal CA used to sign service-to-service mTLS and the cert pinned by
# bootstrap sticks.
INTERNAL_CA_CERT_PATH=/secrets/ca.pem
INTERNAL_CA_KEY_PATH=/secrets/ca-key.pem

# API.
API_LISTEN=:8080
API_PUBLIC_URL=https://deploy.example.com

# Auth-broker.
AUTH_BROKER_LISTEN=:8081
# Code TTL applied at issuance time (overridable per-issuance).
AUTH_BROKER_DEFAULT_CODE_TTL=24h
# How long the issued ephemeral Tailscale auth key is valid for.
AUTH_BROKER_TS_AUTHKEY_TTL=1h
# Per-source-IP rate limit on /redeem.
AUTH_BROKER_RATE_LIMIT_REDEEM_PER_IP_PER_HOUR=30
# Per-code attempt limit.
AUTH_BROKER_RATE_LIMIT_REDEEM_PER_CODE=5
# Per-operator issue-code limit (caps blast radius of compromised admin).
AUTH_BROKER_RATE_LIMIT_ISSUE_PER_OPERATOR_PER_HOUR=100

# Optional: append-only audit log file. Survives Postgres compromise.
# Mount a volume on this path that the operator backs up separately.
AUDIT_FILE=/var/log/deployserver/audit.log

# http-boot.
HTTPBOOT_LISTEN=:8443
HTTPBOOT_TLS_CERT=/secrets/httpboot.pem
HTTPBOOT_TLS_KEY=/secrets/httpboot-key.pem

# Worker.
WORKER_CONCURRENCY=4

# Observability.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=info
LOG_FORMAT=json
