# Public FQDN of the deploy server. Sticks bake this in. Cert presented on
# this name MUST chain to the CA whose cert is embedded on the stick.
DEPLOY_FQDN=deploy.example.com
# Default tailnet name offered by the stick-config generator
# (/api/v1/bootstrap-sticks/config); operators can override per request.
DEPLOY_TAILNET=
# CA certificate (PEM) the bootstrap sticks pin; served to operators by
# the stick-config generator when present.
DEPLOY_CA_CERT_PATH=/secrets/deploy-ca.pem
# When deploying behind nginx-proxy-manager: leave DEPLOY_FQDN at the
# external hostname; the container only binds an internal port.

# Tailnet config. Sticks bake the tailnet name in.
# For Headscale:
HEADSCALE_URL=https://headscale.example.com
HEADSCALE_API_KEY=
HEADSCALE_USER=deploy
# Or, for Tailscale SaaS, leave HEADSCALE_* empty and set:
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=

# Postgres.
POSTGRES_USER=deploy
POSTGRES_PASSWORD=changeme-please
POSTGRES_DB=deploy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MinIO / S3.
S3_ENDPOINT=http://minio:9000
# URL operators' *browsers* can reach the object store on. Presigned
# image-upload URLs are signed against this host. For the small tier,
# expose minio (e.g. https://minio.deploy.example.com) or leave empty
# to sign against S3_ENDPOINT (works only when the operator can resolve it).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=deploy
S3_SECRET_KEY=changeme-please-too
S3_BUCKET_IMAGES=images
S3_BUCKET_DRIVERS=drivers
S3_BUCKET_BLOBS=blobs

# OIDC (for human users / operator UI).
OIDC_ISSUER=https://auth.example.com/realms/deploy
OIDC_CLIENT_ID=deployserver
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://deploy.example.com/auth/callback

# Internal CA + per-service certs for service-to-service mTLS.
# Generated by `make secrets` (calls scripts/gen-internal-ca.sh).
# Each service container reads its own cert; the api's internal listener
# requires client certs signed by this CA.
INTERNAL_CA_CERT_PATH=/secrets/internal-ca.pem
# api service:
#   INTERNAL_TLS_CERT=/secrets/api.pem
#   INTERNAL_TLS_KEY=/secrets/api-key.pem
# http-boot service:
#   INTERNAL_TLS_CERT=/secrets/http-boot.pem
#   INTERNAL_TLS_KEY=/secrets/http-boot-key.pem
# (worker, auth-broker similar)
API_INTERNAL_LISTEN=:8443

# API.
API_LISTEN=:8080
API_PUBLIC_URL=https://deploy.example.com

# Auth-broker.
AUTH_BROKER_LISTEN=:8081
# Code TTL applied at issuance time (overridable per-issuance).
AUTH_BROKER_DEFAULT_CODE_TTL=24h
# How long the issued ephemeral Tailscale auth key is valid for.
AUTH_BROKER_TS_AUTHKEY_TTL=1h
# Per-source-IP rate limit on /redeem.
AUTH_BROKER_RATE_LIMIT_REDEEM_PER_IP_PER_HOUR=30
# Per-code attempt limit.
AUTH_BROKER_RATE_LIMIT_REDEEM_PER_CODE=5
# Per-operator issue-code limit (caps blast radius of compromised admin).
AUTH_BROKER_RATE_LIMIT_ISSUE_PER_OPERATOR_PER_HOUR=100
# Shared secret authenticating the api service to the broker's
# /issue-code endpoint. Generate with: openssl rand -hex 32
# Leaving this empty runs the broker in dev-mode (any internal-network
# caller can mint deployment codes) — set it for any real deployment.
AUTH_BROKER_ISSUE_SHARED_SECRET=

# Optional: append-only audit log file. Survives Postgres compromise.
# Mount a volume on this path that the operator backs up separately.
AUDIT_FILE=/var/log/deployserver/audit.log

# http-boot.
HTTPBOOT_LISTEN=:8443
HTTPBOOT_TLS_CERT=/secrets/httpboot.pem
HTTPBOOT_TLS_KEY=/secrets/httpboot-key.pem

# Worker.
WORKER_CONCURRENCY=4

# Observability.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=info
LOG_FORMAT=json

# --- Wake-on-LAN ------------------------------------------------------
# Shared secret between the api and edge agents for the wake queue
# (GET /v1/edge/wake-queue). Generate with: openssl rand -hex 32
# The endpoint is DISABLED while this is empty (fails closed).
# On each edge box, set the same value as EDGE_WAKE_TOKEN, plus
# EDGE_SITE to match the machines' `site` attribute (default: "default")
# and optionally LAN_BROADCAST for the subnet's directed broadcast.
EDGE_WAKE_TOKEN=

# --- Site-local image mirror (edge box) -------------------------------
# Set on the edge agent, not the server. EDGE_CACHE_LISTEN enables the
# verifying image cache (e.g. ":8090"); register the box's LAN address
# as the site's mirror_base_url in the UI (Sites page). Optional:
# EDGE_CACHE_DIR (default /var/cache/deploy-images) and
# EDGE_CACHE_MAX_BYTES (default 53687091200 = 50 GiB).

# --- Job notifications ------------------------------------------------
# When set, the worker POSTs a JSON webhook for every job reaching a
# terminal state (completed/failed/cancelled). The payload's `text`
# field makes it directly usable as a Slack incoming webhook. Optional
# bearer for generic endpoints via NOTIFY_WEBHOOK_TOKEN.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
