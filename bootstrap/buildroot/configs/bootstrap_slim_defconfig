# Buildroot defconfig for the slim (wired-only) bootstrap image.
# Generated against buildroot-2025.02. Regenerate via:
#   make -C output/buildroot-2025.02 menuconfig savedefconfig
#   cp output/buildroot-2025.02/defconfig configs/bootstrap_slim_defconfig
#
# Notable selections:
#  - busybox as init (no systemd; size matters)
#  - rootfs is initramfs (cpio.gz baked into kernel)
#  - musl libc (smaller than glibc)
#  - kernel from upstream LTS
#  - dialog, dhcpcd, chrony, ca-certificates, openssl, curl, ethtool, iproute2
#  - tailscale binaries dropped in via overlay (we don't use buildroot's
#    tailscale package because it lags upstream)

BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INIT_BUSYBOX=y
BR2_TARGET_GENERIC_HOSTNAME="deploy-bootstrap"
BR2_TARGET_GENERIC_ISSUE="deployserver bootstrap"
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_TARGET_ROOTFS_INITRAMFS=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/kernel-config-slim"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Networking
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_ETHTOOL=y

# CA + TLS
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y

# UI
BR2_PACKAGE_DIALOG=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_TARGET_PROGS=y

# Storage / firmware mode helpers
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_EFIVAR=y
BR2_PACKAGE_EFIBOOTMGR=y

# kexec for BIOS handoff
BR2_PACKAGE_KEXEC=y

# Filesystem overlay (we point this at board/overlay before each build)
BR2_ROOTFS_OVERLAY="board/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/post-build.sh"

# Image post-processing
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
